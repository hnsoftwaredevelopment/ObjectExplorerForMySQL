<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ObjectExplorerForMySql</RootNamespace>
    <AssemblyName>ObjectExplorerForMySql</AssemblyName>
    <UseWPF>true</UseWPF>

    <!-- In-process VisualStudio.Extensibility extension that also contains a VSSDK package (ADR-001). -->
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- Writes "CodeBase"=$PackageFolder$\ObjectExplorerForMySql.dll into the pkgdef, so Visual Studio
         loads the package assembly from the extension folder instead of probing its own IDE folders. -->
    <UseCodebase>true</UseCodebase>
    <CreateVsixContainer>true</CreateVsixContainer>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <DeployExtension Condition="'$(Configuration)' == 'Debug'">true</DeployExtension>
    <AssemblyVersion>2026.11.3.11</AssemblyVersion>
    <FileVersion>2026.11.3.11</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectExplorerForMySql.Core\ObjectExplorerForMySql.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OleMenuCommandService derives from System.ComponentModel.Design.MenuCommandService. -->
    <Reference Include="System.Design" />
    <!-- MEF export of the editor drop handler (E05). -->
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="LICENSE.txt" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <!-- Extension icon in Manage Extensions and on the Marketplace (US-1101); a copy of docs\AppIcon.png (128x128). -->
    <Content Include="Assets\AppIcon.png" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ObjectExplorerImages.imagemanifest" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Resources\Images\*.png" />
    <Content Include=".vsextension\string-resources.json" IncludeInVSIX="true" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="ObjectExplorerCommands.vsct" ResourceName="Menus.ctmenu" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" LogicalName="ObjectExplorerForMySql.Resources.Strings.resources" />
    <!-- Package resources by number (key binding scope name); Visual Studio looks them up as "VSPackage.resources". -->
    <EmbeddedResource Update="Resources\VSPackage.resx" LogicalName="VSPackage.resources" MergeWithCTO="true" />
  </ItemGroup>

</Project>
