<UserControl x:Class="ObjectExplorerForMySql.Editor.QueryResultsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             Height="260"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Tab headers as radio buttons: a line below the active tab, as in the Visual Studio tool windows. -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextActiveBrushKey}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,3">
              <ContentPresenter RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextActiveBrushKey}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="6,1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Used by the result grids that QueryResultsPane.xaml.cs builds. -->
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource {x:Static vsui:HeaderColors.DefaultBrushKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:HeaderColors.DefaultTextBrushKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:HeaderColors.SeparatorLineBrushKey}}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="5,2" />
    </Style>
    <Style x:Key="GridRowHeader" TargetType="DataGridRowHeader">
      <Setter Property="Background" Value="{DynamicResource {x:Static vsui:HeaderColors.DefaultBrushKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:HeaderColors.SeparatorLineBrushKey}}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Width" Value="12" />
    </Style>
    <Style x:Key="GridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,1" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource {x:Static vsui:TreeViewColors.SelectedItemActiveBrushKey}}" />
          <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- Drag to resize the pane. -->
    <Thumb DockPanel.Dock="Top" Height="5" Cursor="SizeNS" DragDelta="OnSplitterDragDelta">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{DynamicResource {x:Static vsui:EnvironmentColors.EnvironmentBackgroundBrushKey}}" />
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>

    <DockPanel DockPanel.Dock="Top" Background="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}">
      <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="&#x2715;"
              ToolTip="{x:Static res:Strings.QueryClosePane}" AutomationProperties.Name="{x:Static res:Strings.QueryClosePane}"
              Click="OnCloseClick" />
      <RadioButton x:Name="ResultsTab" Style="{StaticResource TabButton}" GroupName="QueryResultTabs" IsChecked="True"
                   Content="{x:Static res:Strings.QueryResultsTab}" />
      <RadioButton x:Name="MessagesTab" Style="{StaticResource TabButton}" GroupName="QueryResultTabs"
                   Content="{x:Static res:Strings.QueryMessagesTab}" />
      <RadioButton x:Name="PlanTab" Style="{StaticResource TabButton}" GroupName="QueryResultTabs" Visibility="Collapsed"
                   Content="{x:Static res:Strings.QueryPlanTab}" />
      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Strings.QueryRunning}"
                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
    </DockPanel>

    <Grid>
      <ContentControl x:Name="ResultsHost" Focusable="False"
                      Visibility="{Binding IsChecked, ElementName=ResultsTab, Converter={StaticResource BoolToVisibility}}" />
      <TextBox x:Name="MessagesBox" IsReadOnly="True" BorderThickness="0" Padding="6,4"
               FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
               Visibility="{Binding IsChecked, ElementName=MessagesTab, Converter={StaticResource BoolToVisibility}}" />
      <!-- US-1301: estimated plan; costly steps get a warning icon, the tooltip lists every value of the step. -->
      <TreeView x:Name="PlanTree" ItemsSource="{Binding Plan}" BorderThickness="0" Padding="2,4"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                Visibility="{Binding IsChecked, ElementName=PlanTab, Converter={StaticResource BoolToVisibility}}">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding DetailText}">
              <imaging:CrispImage Width="16" Height="16" Margin="0,0,4,0" Moniker="{x:Static catalog:KnownMonikers.StatusWarning}"
                                  Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary}" Margin="8,0,0,0" Opacity="0.75" />
              <TextBlock Text="{Binding WarningText}" Margin="8,0,0,0" FontStyle="Italic" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>
  </DockPanel>
</UserControl>
