<UserControl x:Class="ObjectExplorerForMySql.ToolWindows.DependenciesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:deps="clr-namespace:ObjectExplorerForMySql.Core.Dependencies;assembly=ObjectExplorerForMySql.Core"
             xmlns:local="clr-namespace:ObjectExplorerForMySql.ToolWindows"
             Background="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundTextBrushKey}}">
  <UserControl.Resources>
    <local:NodeIconConverter x:Key="NodeIconToMoniker" />
    <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundTextBrushKey}}" />
      <Setter Property="IsExpanded" Value="True" />
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type deps:DependencyGroupViewModel}" ItemsSource="{Binding Items}">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding EmptyText}" Margin="8,0,0,0" Opacity="0.7" FontStyle="Italic"
                   Visibility="{Binding EmptyText, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>
    </HierarchicalDataTemplate>

    <!-- Double-click or Enter selects the object in the explorer. -->
    <DataTemplate DataType="{x:Type deps:DependencyItemViewModel}">
      <StackPanel Orientation="Horizontal" Margin="0,1" Background="Transparent" MouseLeftButtonDown="OnItemMouseDown">
        <imaging:CrispImage Width="16" Height="16" Margin="0,0,4,0" Moniker="{Binding Icon, Converter={StaticResource NodeIconToMoniker}}" />
        <TextBlock Text="{Binding Label}" />
        <TextBlock Text="{Binding Note}" Margin="8,0,0,0" Opacity="0.7" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="6,4,6,2">
      <TextBlock Text="{Binding Title}" FontWeight="Bold" />
      <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" Margin="6,2,6,4" TextWrapping="Wrap" Opacity="0.8" FontStyle="Italic"
               Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Groups}" BorderThickness="0" Padding="2,2"
              Background="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundBrushKey}}"
              KeyDown="OnTreeKeyDown" />
  </DockPanel>
</UserControl>
