<UserControl x:Class="ObjectExplorerForMySql.ToolWindows.ExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:explorer="clr-namespace:ObjectExplorerForMySql.Core.Explorer;assembly=ObjectExplorerForMySql.Core"
             xmlns:local="clr-namespace:ObjectExplorerForMySql.ToolWindows"
             xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
             Background="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundTextBrushKey}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:NodeIconConverter x:Key="NodeIconToMoniker" />
    <local:ConnectionStateTextConverter x:Key="StateText" />

    <!-- Expand/collapse glyph in Visual Studio tree colors. -->
    <Style x:Key="ExpanderToggleStyle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <Path x:Name="Glyph"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M 0,0 L 4,4 L 0,8 Z"
                    Fill="{DynamicResource {x:Static platformUi:TreeViewColors.GlyphBrushKey}}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Glyph" Property="Data" Value="M 6,0 L 6,6 L 0,6 Z" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource {x:Static platformUi:TreeViewColors.GlyphMouseOverBrushKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Every tree item (all levels): Visual Studio selection colors, expand state bound to the view model. -->
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundTextBrushKey}}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <!-- A node selected from code (View Dependencies, US-1303) scrolls into view. -->
      <EventSetter Event="Selected" Handler="OnItemSelected" />
      <!-- Hidden by the name filter (US-0308). -->
      <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Bd" Background="Transparent" Padding="0,1,4,1" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="Expander"
                                Style="{StaticResource ExpanderToggleStyle}"
                                ClickMode="Press"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemActiveBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
              </Trigger>
              <!-- Extra columns of a multi-selection (US-0502) look like the selected node. -->
              <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemActiveBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
              </DataTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True" />
                  <Condition Property="IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveTextBrushKey}}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Server node: state icon, dimmed when not connected, tooltip with state, version, user and last error (US-0204). -->
    <HierarchicalDataTemplate DataType="{x:Type explorer:ServerNodeViewModel}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <StackPanel.ToolTip>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.TooltipServer}" FontWeight="SemiBold" Margin="0,0,8,0" />
            <TextBlock Grid.Row="0" Grid.Column="1">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}:{1}">
                  <Binding Path="Definition.Host" />
                  <Binding Path="Definition.Port" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.TooltipUser}" FontWeight="SemiBold" Margin="0,0,8,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserName}" />
            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.TooltipState}" FontWeight="SemiBold" Margin="0,0,8,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding State, Converter={StaticResource StateText}}" />
            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.TooltipVersion}" FontWeight="SemiBold" Margin="0,0,8,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServerVersion, TargetNullValue='-'}" />
            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.TooltipLastError}" FontWeight="SemiBold" Margin="0,0,8,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastError}" TextWrapping="Wrap" MaxWidth="400"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </StackPanel.ToolTip>
        <imaging:CrispImage x:Name="Icon" Width="16" Height="16" Margin="0,0,4,0"
                            Moniker="{Binding Icon, Converter={StaticResource NodeIconToMoniker}}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static explorer:ConnectionState.NotConnected}">
          <Setter TargetName="Icon" Property="Opacity" Value="0.5" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!-- Every other node (folders, databases, "Loading...", errors). -->
    <HierarchicalDataTemplate DataType="{x:Type explorer:TreeNodeViewModel}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding ToolTip}">
        <imaging:CrispImage Width="16" Height="16" Margin="0,0,4,0"
                            Moniker="{Binding Icon, Converter={StaticResource NodeIconToMoniker}}" />
        <TextBlock x:Name="Text" Text="{Binding Label}" VerticalAlignment="Center" />
        <!-- Inline rename (US-0902): shown while IsEditing; Enter or leaving the box renames, Escape cancels. -->
        <TextBox x:Name="EditBox" Visibility="Collapsed" MinWidth="140" Padding="1,0" VerticalAlignment="Center"
                 Background="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundBrushKey}}"
                 Foreground="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundTextBrushKey}}"
                 CaretBrush="{DynamicResource {x:Static platformUi:TreeViewColors.BackgroundTextBrushKey}}"
                 BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}"
                 IsVisibleChanged="OnEditBoxVisibleChanged"
                 PreviewKeyDown="OnEditBoxPreviewKeyDown"
                 LostKeyboardFocus="OnEditBoxLostKeyboardFocus" />
      </StackPanel>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon}" Value="{x:Static explorer:NodeIcon.Loading}">
          <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEditing}" Value="True">
          <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </UserControl.Resources>

  <Grid>
    <TreeView x:Name="Tree"
              ItemsSource="{Binding Servers}"
              Background="Transparent"
              BorderThickness="0"
              Padding="2"
              ContextMenu="{x:Null}"
              SelectedItemChanged="OnSelectedItemChanged"
              PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
              PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
              PreviewMouseMove="OnPreviewMouseMove"
              PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
              MouseRightButtonUp="OnMouseRightButtonUp"
              ContextMenuOpening="OnContextMenuOpening"
              KeyDown="OnTreeKeyDown" />

    <TextBlock Margin="12"
               TextWrapping="Wrap"
               Text="{x:Static res:Strings.EmptyExplorerHint}"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
