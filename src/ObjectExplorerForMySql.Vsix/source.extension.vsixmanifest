<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="ObjectExplorerForMySql.hnsoftwaredevelopment" Version="0.5.0" Language="en-US" Publisher="Herbert Nijkamp" />
    <DisplayName>Object Explorer for MySQL</DisplayName>
    <Description xml:space="preserve">A MySQL object explorer for Visual Studio, modeled on SQL Server Object Explorer. Browse servers, databases, tables, columns, keys, indexes, triggers, views, routines, events, users and roles, and drag names into your code. Run queries in a MySQL editor with syntax coloring, IntelliSense, execution plans and CSV/JSON export. View and edit table data, script objects or a whole database, see the dependencies of an object, generate database documentation as Markdown or PDF, and watch the sessions of a server in the activity monitor. MySQL 8.0+ and MariaDB. Not affiliated with Oracle Corporation.</Description>
    <MoreInfo>https://github.com/hnsoftwaredevelopment/ObjectExplorerForMySQL</MoreInfo>
    <License>LICENSE.txt</License>
    <ReleaseNotes>https://github.com/hnsoftwaredevelopment/ObjectExplorerForMySQL/blob/main/CHANGELOG.md</ReleaseNotes>
    <Icon>Assets\AppIcon.png</Icon>
    <PreviewImage>Assets\AppIcon.png</PreviewImage>
    <Tags>MySQL, MariaDB, database, object explorer, SQL, query editor, IntelliSense, execution plan, documentation</Tags>
  </Metadata>
  <Installation ExtensionType="VSSDK+VisualStudio.Extensibility">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <!-- Editor drop handler for objects dragged from the explorer (E05). -->
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    <!-- Own images (Explain, Explain Analyze): without this asset Visual Studio does not read the manifest into its
         image library, and the monikers show no image. -->
    <Asset Type="Microsoft.VisualStudio.ImageManifest" d:Source="File" Path="ObjectExplorerImages.imagemanifest" />
  </Assets>
</PackageManifest>
