<platformUi:DialogWindow x:Class="ObjectExplorerForMySql.Dialogs.UserDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
                         Width="480"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         HasMinimizeButton="False"
                         HasMaximizeButton="False"
                         Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
  <platformUi:DialogWindow.Resources>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
  </platformUi:DialogWindow.Resources>

  <!-- US-1003: New User (name, host, password) and Change Password (password only). The SQL shows the password masked. -->
  <StackPanel Margin="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label x:Name="NameLabel" Content="{x:Static res:Strings.UserName}" Target="{Binding ElementName=NameBox}" />
      <TextBox x:Name="NameBox" Grid.Column="1" Padding="2,1" Margin="0,0,0,6" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
      <Label x:Name="HostLabel" Grid.Row="1" Content="{x:Static res:Strings.UserHost}" Target="{Binding ElementName=HostBox}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel x:Name="HostPanel" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
        <TextBox x:Name="HostBox" Padding="2,1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.75" Text="{x:Static res:Strings.UserHostHint}" />
      </StackPanel>
      <Label Grid.Row="2" Content="{x:Static res:Strings.UserPassword}" Target="{Binding ElementName=PasswordBox}" />
      <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Padding="2,1" Margin="0,0,0,6" PasswordChanged="OnPasswordChanged" />
      <Label Grid.Row="3" Content="{x:Static res:Strings.UserConfirmPassword}" Target="{Binding ElementName=ConfirmBox}" />
      <PasswordBox x:Name="ConfirmBox" Grid.Row="3" Grid.Column="1" Padding="2,1" PasswordChanged="OnPasswordChanged" />
      <TextBlock x:Name="ProblemText" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>

    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.NewDatabaseSql}" />
    <TextBox Text="{Binding DisplaySql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
             TextWrapping="Wrap" MinHeight="40" Padding="4,3" AutomationProperties.Name="SQL" />

    <Separator Margin="0,12,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OkButton" IsDefault="True" IsEnabled="{Binding CanRun}" Click="OnOkClick" />
      <Button Margin="6,0,0,0" IsCancel="True" Content="{x:Static res:Strings.ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</platformUi:DialogWindow>
