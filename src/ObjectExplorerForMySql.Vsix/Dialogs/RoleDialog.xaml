<platformUi:DialogWindow x:Class="ObjectExplorerForMySql.Dialogs.RoleDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
                         Title="{x:Static res:Strings.NewRoleTitle}"
                         Width="460"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         HasMinimizeButton="False"
                         HasMaximizeButton="False"
                         Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
  <platformUi:DialogWindow.Resources>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
  </platformUi:DialogWindow.Resources>

  <!-- US-1004: CREATE ROLE with the exact SQL; the host only on MySQL. -->
  <StackPanel Margin="12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Content="{x:Static res:Strings.RoleName}" Target="{Binding ElementName=NameBox}" />
      <TextBox x:Name="NameBox" Grid.Column="1" Padding="2,1" Margin="0,0,0,6" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      <Label x:Name="HostLabel" Grid.Row="1" Content="{x:Static res:Strings.UserHost}" Target="{Binding ElementName=HostBox}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel x:Name="HostPanel" Grid.Row="1" Grid.Column="1">
        <TextBox x:Name="HostBox" Padding="2,1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.75" Text="{x:Static res:Strings.RoleHostHint}" />
      </StackPanel>
      <TextBlock x:Name="ProblemText" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                 Text="{x:Static res:Strings.RoleExists}" />
    </Grid>

    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.NewDatabaseSql}" />
    <TextBox Text="{Binding Sql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
             TextWrapping="Wrap" MinHeight="40" Padding="4,3" AutomationProperties.Name="SQL" />

    <Separator Margin="0,12,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsDefault="True" Content="{x:Static res:Strings.ButtonCreate}" IsEnabled="{Binding CanRun}" Click="OnCreateClick" />
      <Button Margin="6,0,0,0" IsCancel="True" Content="{x:Static res:Strings.ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</platformUi:DialogWindow>
