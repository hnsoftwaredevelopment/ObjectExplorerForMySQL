<platformUi:DialogWindow x:Class="ObjectExplorerForMySql.Dialogs.NewDatabaseDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
                         Title="{x:Static res:Strings.NewDatabaseTitle}"
                         Width="480"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         HasMinimizeButton="False"
                         HasMaximizeButton="False"
                         Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
  <platformUi:DialogWindow.Resources>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
  </platformUi:DialogWindow.Resources>

  <!-- US-0903: name, character set and collation, with the exact SQL below, as in the Delete dialog. -->
  <StackPanel Margin="12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Content="{x:Static res:Strings.NewDatabaseName}" Target="{Binding ElementName=NameBox}" />
      <TextBox x:Name="NameBox" Grid.Column="1" Padding="2,1" MaxLength="80"
               Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock x:Name="ProblemText" Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

      <Label Grid.Row="2" Margin="0,8,0,0" Content="{x:Static res:Strings.NewDatabaseCharacterSet}" Target="{Binding ElementName=SetBox}" />
      <ComboBox x:Name="SetBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                ItemsSource="{Binding CharacterSets}" SelectedItem="{Binding CharacterSet}" DisplayMemberPath="Display" />
      <Label Grid.Row="3" Margin="0,6,0,0" Content="{x:Static res:Strings.NewDatabaseCollation}" Target="{Binding ElementName=CollationBox}" />
      <ComboBox x:Name="CollationBox" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                ItemsSource="{Binding Collations}" SelectedItem="{Binding Collation}" DisplayMemberPath="Name" />
    </Grid>

    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.NewDatabaseSql}" />
    <TextBox Text="{Binding Sql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
             TextWrapping="Wrap" MinHeight="40" Padding="4,3" AutomationProperties.Name="SQL" />

    <Separator Margin="0,12,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsDefault="True" Content="{x:Static res:Strings.ButtonCreate}" IsEnabled="{Binding CanCreate}" Click="OnCreateClick" />
      <Button Margin="6,0,0,0" IsCancel="True" Content="{x:Static res:Strings.ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</platformUi:DialogWindow>
