<platformUi:DialogWindow x:Class="ObjectExplorerForMySql.Dialogs.GrantDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
                         Title="{x:Static res:Strings.GrantTitle}"
                         Width="540"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         HasMinimizeButton="False"
                         HasMaximizeButton="False"
                         Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
  <platformUi:DialogWindow.Resources>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
  </platformUi:DialogWindow.Resources>

  <!-- US-1003: GRANT ... ON `db`.* TO account, with the exact SQL below. -->
  <StackPanel Margin="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Label Content="{x:Static res:Strings.GrantDatabase}" Target="{Binding ElementName=DatabaseBox}" />
      <ComboBox x:Name="DatabaseBox" Grid.Column="1" ItemsSource="{Binding Databases}" SelectedItem="{Binding Database}" />
    </Grid>

    <CheckBox Content="{x:Static res:Strings.GrantAll}" IsChecked="{Binding All}" Margin="0,0,0,6" />
    <!-- Underscores in privilege names must not become access keys: TextBlock content. -->
    <ItemsControl ItemsSource="{Binding Privileges}" IsEnabled="{Binding CanChoosePrivileges}" Margin="18,0,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
            <TextBlock Text="{Binding Name}" />
          </CheckBox>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox Content="{x:Static res:Strings.GrantWithGrantOption}" IsChecked="{Binding WithGrantOption}" Margin="0,8,0,0" />

    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.NewDatabaseSql}" />
    <TextBox Text="{Binding Sql, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
             TextWrapping="Wrap" MinHeight="40" Padding="4,3" AutomationProperties.Name="SQL" />

    <Separator Margin="0,12,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsDefault="True" Content="{x:Static res:Strings.ButtonGrant}" IsEnabled="{Binding CanGrant}" Click="OnGrantClick" />
      <Button Margin="6,0,0,0" IsCancel="True" Content="{x:Static res:Strings.ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</platformUi:DialogWindow>
