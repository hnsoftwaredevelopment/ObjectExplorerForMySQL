<platformUi:DialogWindow x:Class="ObjectExplorerForMySql.Dialogs.PasswordDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:res="clr-namespace:ObjectExplorerForMySql.Resources"
                         Title="{x:Static res:Strings.PasswordDialogTitle}"
                         Width="380"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         HasMinimizeButton="False"
                         HasMaximizeButton="False"
                         Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
  <platformUi:DialogWindow.Resources>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
  </platformUi:DialogWindow.Resources>

  <StackPanel Margin="12">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />

    <Grid Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Content="{x:Static res:Strings.ConnectionUserName}" />
      <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,0,0,6" Padding="2,1" IsReadOnly="True"
               Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
      <Label Grid.Row="1" Content="{x:Static res:Strings.ConnectionPassword}" Target="{Binding ElementName=PasswordBox}" />
      <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Padding="2,1" />
    </Grid>

    <CheckBox x:Name="SavePasswordBox" Margin="0,4,0,0" Content="{x:Static res:Strings.ConnectionSavePassword}" />

    <Separator Margin="0,12,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button IsDefault="True" Content="{x:Static res:Strings.ButtonConnect}" Click="OnConnectClick" />
      <Button Margin="6,0,0,0" IsCancel="True" Content="{x:Static res:Strings.ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</platformUi:DialogWindow>
